# Developer machine only. See https://github.com/ibm-messaging/mq-container/blob/master/docs/usage.md
IBM_MQ_LICENSE=accept
IBM_MQ_PLATFORM=linux/amd64
IBM_MQ_HOST=127.0.0.1
IBM_MQ_PORT=21414
IBM_MQ_QUEUE_MANAGER=QM1
IBM_MQ_CHANNEL=DEV.APP.SVRCONN
IBM_MQ_USER=app
# Provide real values outside Git; no password defaults are configured.
IBM_MQ_APP_PASSWORD=
IBM_MQ_ADMIN_PASSWORD=
# Set IBM_MQ_PASSWORD to the same value as IBM_MQ_APP_PASSWORD for the runtime.
IBM_MQ_PASSWORD=
IIB_JMS_DLQ=IIB.DLQ
