      </nodes>
      <nodes xmi:type="ComIbmTrace.msgnode:FCMComposite_1" xmi:id="TraceNode" location="376,80" destinationTraceLevel="messageFlow" destinationTraceNode="userTrace">
        <translation xmi:type="utility:ConstantString" string="Audit trace"/>
      </nodes>
      <nodes xmi:type="eflow:FCMSink" xmi:id="SinkFlow" location="552,80">
