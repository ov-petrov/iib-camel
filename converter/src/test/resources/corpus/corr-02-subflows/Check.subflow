    xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility" nsURI="Check.subflow" nsPrefix="Check.subflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <translation xmi:type="utility:TranslatableString" key="Check" bundleName="Check" pluginId="OrderApplication"/>
    <composition>
      <nodes xmi:type="eflow:FCMSource" xmi:id="SourceFlow" location="24,80">
        <translation xmi:type="utility:ConstantString" string="Input"/>
      </nodes>
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="CheckStep" location="200,80" computeExpression="esql://routine/check#Check_Compute1.Main">
