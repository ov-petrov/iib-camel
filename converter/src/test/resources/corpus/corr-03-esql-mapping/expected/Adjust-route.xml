<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
  <route id="Adjust">
    <from uri="jms:ADJUST.IN?transacted=true&amp;disableReplyTo=true"/>
    <bean beanType="ru.petrovov.iib_camel.runtime.compute.MessageSnapshots" method="capture"/>
    <doTry>
      <to uri="bean:adjustCompute1"/>
      <to uri="jms:ADJUST.OUT"/>
      <doCatch>
        <exception>java.lang.Exception</exception>
        <bean beanType="ru.petrovov.iib_camel.runtime.compute.MessageSnapshots" method="restore"/>
        <to uri="jms:ADJUST.ERROR.Q"/>
      </doCatch>
      <doFinally>
        <bean beanType="ru.petrovov.iib_camel.runtime.compute.MessageSnapshots" method="release"/>
      </doFinally>
    </doTry>
  </route>
</routes>
