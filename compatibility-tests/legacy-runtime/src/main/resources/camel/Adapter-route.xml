<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">

    <route id="Adapter">
    <from uri="jms:ADAPTER.IN?transacted=true&amp;disableReplyTo=true"/>
    <bean beanType="ru.petrovov.iib_camel.runtime.compute.MessageSnapshots" method="capture"/>
    <doTry>

        <to uri="bean:adapterCompute1"/>

        <choice>
        <when>
          <xpath>/Adapter/Order/status=&apos;HIGH&apos;</xpath>

            <to uri="jms:ADAPTER.PRIORITY.Q"/>
        </when>
        <otherwise>

            <to uri="jms:ADAPTER.DEFAULT.Q"/>
        </otherwise>
      </choice>
      <doCatch>
        <exception>java.lang.Exception</exception>
        <bean beanType="ru.petrovov.iib_camel.runtime.compute.MessageSnapshots" method="restore"/>

          <to uri="jms:ADAPTER.ERROR.Q"/>
      </doCatch>
      <doFinally>
        <bean beanType="ru.petrovov.iib_camel.runtime.compute.MessageSnapshots" method="release"/>
      </doFinally>
    </doTry>
  </route>
</routes>
