<routes xmlns="http://camel.apache.org/schema/spring">
  <!-- source: узел Input (MQInput) -->
  <route id="Order">
    <from uri="jms:ORDERS.IN?transacted=true&amp;disableReplyTo=true"/>
    <bean beanType="ru.petrovov.iib_camel.runtime.compute.MessageSnapshots" method="capture"/>
    <doTry>
      <removeProperty name="iib_complete_436865636b2e737562666c6f77"/>
      <!-- source: узел CheckRef (Subflow) -->
      <to uri="direct:Check"/>
      <filter>
        <exchangeProperty>iib_complete_436865636b2e737562666c6f77</exchangeProperty>
        <!-- source: узел Acked (MQOutput) -->
        <to uri="jms:ORDERS.OUT"/>
      </filter>
      <removeProperty name="iib_complete_436865636b2e737562666c6f77"/>
      <doCatch>
        <exception>java.lang.Exception</exception>
        <bean beanType="ru.petrovov.iib_camel.runtime.compute.MessageSnapshots" method="restore"/>
        <!-- source: узел Rejected (MQOutput) -->
        <to uri="jms:ORDERS.ERROR.Q"/>
      </doCatch>
      <doFinally>
        <bean beanType="ru.petrovov.iib_camel.runtime.compute.MessageSnapshots" method="release"/>
      </doFinally>
    </doTry>
  </route>
  <!-- source: подпоток Check.subflow -->
