<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         child.project.url.inherit.append.path="false"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>ru.petrovov.iib_camel</groupId>
    <artifactId>iib-camel</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>iib-camel</name>
    <description>IIB to Spring Boot + Apache Camel migration: converter (one-shot CLI) and runtime service</description>
    <url>https://github.com/ov-petrov/iib-camel</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>ov-petrov</id>
            <name>Oleg Petrov</name>
            <url>https://github.com/ov-petrov</url>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/ov-petrov/iib-camel.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ov-petrov/iib-camel.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/ov-petrov/iib-camel</url>
    </scm>

    <modules>
        <module>converter</module>
        <module>runtime</module>
    </modules>

    <properties>
        <java.version>25</java.version>
    </properties>
</project>
