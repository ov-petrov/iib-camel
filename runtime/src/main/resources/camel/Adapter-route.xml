<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
  <!-- source: узел Input (MQInput) -->
  <route id="Adapter">
    <from uri="jms:ADAPTER.IN"/>
    <bean beanType="com.example.iib_camel.runtime.compute.MessageSnapshots" method="capture"/>
    <doTry>
      <!-- source: узел Enrich (Compute) -->
      <to uri="bean:adapterCompute1"/>
      <!-- source: узел RouteByStatus (Route) -->
      <choice>
        <when>
          <xpath>/Adapter/Order/status=&apos;HIGH&apos;</xpath>
          <!-- source: узел PriorityQueue (MQOutput) -->
          <to uri="jms:ADAPTER.PRIORITY.Q"/>
        </when>
        <otherwise>
          <!-- source: узел DefaultQueue (MQOutput) -->
          <to uri="jms:ADAPTER.DEFAULT.Q"/>
        </otherwise>
      </choice>
      <doCatch>
        <exception>java.lang.Exception</exception>
        <bean beanType="com.example.iib_camel.runtime.compute.MessageSnapshots" method="restore"/>
        <!-- source: узел ErrorQueue (MQOutput) -->
        <to uri="jms:ADAPTER.ERROR.Q"/>
      </doCatch>
      <doFinally>
        <bean beanType="com.example.iib_camel.runtime.compute.MessageSnapshots" method="release"/>
      </doFinally>
    </doTry>
  </route>
</routes>
