<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath />
  </parent>
  <groupId>ru.petrovov.iib_camel</groupId>
  <artifactId>iib-camel-runtime-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Independent integration runtime</name>
  <properties>
    <java.version>21</java.version>
    <camel.version>4.22.2</camel.version>
    <ibm-mq.version>9.4.5.1</ibm-mq.version>
  </properties>
  <modules>
    <module>runtime-core</module>
    <module>runtime-delivery</module>
    <module>modules/example-module</module>
    <module>runtime-app</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.camel</groupId>
        <artifactId>camel-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>ru.petrovov.iib_camel</groupId>
        <artifactId>iib-camel-runtime-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>ru.petrovov.iib_camel</groupId>
        <artifactId>iib-camel-runtime-delivery</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>ru.petrovov.iib_camel</groupId>
        <artifactId>iib-camel-example-module</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
