<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode"
    xmlns:Ghost.subflow="Ghost.subflow"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:eflow="http://www.ibm.com/wbi/2005/eflow"
    xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility"
    nsURI="UnvalidatedGraph.msgflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1"><composition>
    <nodes xmi:type="eflow:FCMSource" xmi:id="Input"><translation xmi:type="utility:ConstantString" string="Input"/></nodes>
    <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="Compute" computeExpression="esql://routine/missing#MissingModule.Main"><translation xmi:type="utility:ConstantString" string="Missing ESQL"/></nodes>
    <nodes xmi:type="Ghost.subflow:FCMComposite_1" xmi:id="MissingSubflow"><translation xmi:type="utility:ConstantString" string="Unresolved subflow"/></nodes>
    <nodes xmi:type="eflow:FCMSink" xmi:id="Output"><translation xmi:type="utility:ConstantString" string="Output"/></nodes>
    <connections xmi:type="eflow:FCMConnection" xmi:id="C1" sourceNode="Input" sourceTerminalName="OutTerminal.out" targetNode="Compute" targetTerminalName="InTerminal.in"/>
    <connections xmi:type="eflow:FCMConnection" xmi:id="C2" sourceNode="Compute" sourceTerminalName="OutTerminal.out" targetNode="MissingSubflow" targetTerminalName="InTerminal.in"/>
    <connections xmi:type="eflow:FCMConnection" xmi:id="C3" sourceNode="MissingSubflow" sourceTerminalName="OutTerminal.out" targetNode="Output" targetTerminalName="InTerminal.in"/>
    <connections xmi:type="eflow:FCMConnection" xmi:id="C4" sourceNode="Output" sourceTerminalName="OutTerminal.out" targetNode="Compute" targetTerminalName="InTerminal.in"/>
  </composition></eClassifiers>
</ecore:EPackage>
