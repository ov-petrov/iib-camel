<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:eflow="http://www.ibm.com/wbi/2005/eflow"
    xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility"
    xmlns:ComIbmMQOutput.msgnode="ComIbmMQOutput.msgnode"
    nsURI="Publisher.subflow" nsPrefix="Publisher.subflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <composition>
      <nodes xmi:type="eflow:FCMSource" xmi:id="In">
        <translation xmi:type="utility:ConstantString" string="Input"/>
      </nodes>
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="Out" queueName="DEMO.DEFAULT" destinationQueueManagerName="QM_DEMO">
        <translation xmi:type="utility:ConstantString" string="Publish"/>
      </nodes>
      <nodes xmi:type="eflow:FCMSink" xmi:id="Done">
        <translation xmi:type="utility:ConstantString" string="Output"/>
      </nodes>
      <connections xmi:type="eflow:FCMConnection" xmi:id="C1" sourceNode="In" sourceTerminalName="OutTerminal.out" targetNode="Out" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="C2" sourceNode="Out" sourceTerminalName="OutTerminal.out" targetNode="Done" targetTerminalName="InTerminal.in"/>
    </composition>
    <eStructuralFeatures xmi:type="ecore:EAttribute" xmi:id="Property.targetQueue" name="targetQueue" defaultValueLiteral="DEMO.DEFAULT"/>
    <attributeLinks promotedAttribute="targetQueue" overriddenNodes="Out">
      <overriddenAttribute href="Publisher.subflow#queueName"/>
    </attributeLinks>
  </eClassifiers>
</ecore:EPackage>
