<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:eflow="http://www.ibm.com/wbi/2005/eflow"
    xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility"
    xmlns:ComIbmMQInput.msgnode="ComIbmMQInput.msgnode"
    xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode"
    xmlns:Publisher.subflow="Publisher.subflow"
    nsURI="Publisher.msgflow" nsPrefix="Publisher.msgflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1">
    <composition>
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="Start" queueName="DEMO.START" destinationQueueManagerName="QM_DEMO"/>
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="Transform" computeExpression="esql://routine/missing#Transform.Main"/>
      <nodes xmi:type="Publisher.subflow:FCMComposite_1" xmi:id="NextRef" targetQueue="DEMO.NEXT"/>
      <nodes xmi:type="Publisher.subflow:FCMComposite_1" xmi:id="AuditRef" targetQueue="DEMO.AUDIT"/>
      <nodes xmi:type="eflow:FCMSink" xmi:id="End"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="C1" sourceNode="Start" sourceTerminalName="OutTerminal.out" targetNode="Transform" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="C2" sourceNode="Transform" sourceTerminalName="OutTerminal.out" targetNode="NextRef" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="C3" sourceNode="NextRef" sourceTerminalName="OutTerminal.out" targetNode="AuditRef" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="C4" sourceNode="AuditRef" sourceTerminalName="OutTerminal.out" targetNode="End" targetTerminalName="InTerminal.in"/>
    </composition>
  </eClassifiers>
</ecore:EPackage>
